    <string name="onboarding_how_title">How it works</string>
    <string name="onboarding_how_1">Tap the bubble (or the mini-dot) above your keyboard to start.</string>
    <string name="onboarding_how_2">Speak naturally — the live waveform shows you are being heard.</string>
    <string name="onboarding_how_3">Tap the green check to insert the text at your cursor.</string>
    <string name="onboarding_setup_title">Set up in a few steps</string>
    <string name="onboarding_overlay">Overlay permission</string>
    <string name="onboarding_overlay_desc">Lets the bubble float above other apps.</string>
